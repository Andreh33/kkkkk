# Database
DATABASE_URL="postgresql://user:password@host:5432/formaylinea?schema=public"

# Auth
AUTH_SECRET=                 # generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Admin seed
ADMIN_EMAIL="info@formaylinea.info"
ADMIN_PASSWORD=               # change in production

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Forma y Línea <hola@formaylinea.info>"
EMAIL_ADMIN="info@formaylinea.info"

# Uploads (UploadThing)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Maps (optional if using embed)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
